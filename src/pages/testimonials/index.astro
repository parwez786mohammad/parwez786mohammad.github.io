---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TestimonialCard from '../../components/TestimonialCard.astro';
import { getCollection } from 'astro:content';

const testimonials = await getCollection('testimonials');
const categories = ['Client', 'Colleague', 'Leadership', 'Toastmasters'] as const;
---
<BaseLayout title="What People Are Saying" description="What clients, colleagues, leaders, and fellow Toastmasters say about working with Mohammad Parwez.">
  <section class="border-b border-ink-950/8 bg-brand-50/30 py-16">
    <div class="container-page max-w-3xl">
      <p class="eyebrow">Social Proof</p>
      <h1 class="mt-3 font-serif text-4xl font-semibold text-ink-950 sm:text-5xl">What People Are Saying</h1>
      <p class="mt-5 text-ink-700">
        Real words from people I've worked with — added manually, and only with permission. Nothing here is
        pulled automatically from LinkedIn or anywhere else.
      </p>
    </div>
  </section>

  <section class="py-16">
    <div class="container-page space-y-14">
      {categories.map((cat) => {
        const items = testimonials.filter((t) => t.data.category === cat);
        return (
          <div>
            <h2 class="font-serif text-2xl font-semibold text-ink-950">{cat} Feedback</h2>
            {items.length === 0 ? (
              <p class="mt-4 text-sm text-ink-500">No testimonials added yet in this category.</p>
            ) : (
              <div class="mt-6 columns-1 gap-6 sm:columns-2 lg:columns-3">
                {items.map((t) => (
                  <div class="mb-6 break-inside-avoid">
                    <TestimonialCard testimonial={t} />
                  </div>
                ))}
              </div>
            )}
          </div>
        );
      })}

      {testimonials.length === 0 && (
        <div class="rounded-2xl border border-dashed border-ink-950/15 p-10 text-center">
          <p class="text-ink-600">Testimonials are on the way. Have you worked with me? I'd love to add your words here — with your permission.</p>
          <a href="/contact" class="btn btn-primary mt-6">Send a Testimonial</a>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
