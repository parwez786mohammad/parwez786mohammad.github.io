---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found" description="This page doesn't exist.">
  <section class="py-32 text-center">
    <div class="container-page">
      <p class="eyebrow">404</p>
      <h1 class="mt-3 font-serif text-4xl font-semibold text-ink-950">Page not found</h1>
      <p class="mt-4 text-ink-600">The page you're looking for doesn't exist or has moved.</p>
      <a href="/" class="btn btn-primary mt-8">Back to Home</a>
    </div>
  </section>
</BaseLayout>
