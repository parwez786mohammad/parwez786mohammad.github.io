---
import BaseLayout from '../layouts/BaseLayout.astro';

const links = [
  { href: '/projects/', label: 'Case Studies', text: 'Automation and transformation projects I led' },
  { href: '/blog/', label: 'Blog', text: 'Automation, AI, leadership and growth' },
  { href: '/about/', label: 'About', text: 'My story, career and journey' },
  { href: '/contact/', label: 'Contact', text: 'Get in touch' },
];
---
<BaseLayout title="Page Not Found" description="This page doesn't exist." noindex>
  <section class="py-24">
    <div class="container-page max-w-3xl text-center">
      <p class="eyebrow">404</p>
      <h1 class="mt-3 font-serif text-4xl font-semibold text-ink-950">Page not found</h1>
      <p class="mt-4 text-ink-600">The page you're looking for doesn't exist or has moved. These might help:</p>
      <div class="mt-10 grid gap-4 text-left sm:grid-cols-2">
        {links.map((l) => (
          <a href={l.href} class="card p-5">
            <span class="block font-serif font-semibold text-ink-950">{l.label} →</span>
            <span class="mt-1 block text-sm text-ink-600">{l.text}</span>
          </a>
        ))}
      </div>
      <a href="/" class="btn btn-primary mt-10">Back to Home</a>
    </div>
  </section>
</BaseLayout>
