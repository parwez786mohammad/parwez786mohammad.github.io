---
// The Journey page was merged into About in Oct 2026. GitHub Pages can't send server-side
// redirects, so this page forwards visitors (and old links) to the new section.
const target = '/about/#journey';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>My Journey | Mohammad Parwez</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={new URL(target, Astro.site)} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <p>My Journey is now part of the About page: <a href={target}>continue to My Journey</a>.</p>
  </body>
</html>
