---
import BaseLayout from '../layouts/BaseLayout.astro';

const stages = [
  {
    period: '2022 — Present', tag: 'Current', title: 'Project Manager', place: 'SPAN Trading L.L.C. · Dubai, UAE',
    summary: 'Leading automation and AI-driven digital transformation across diverse domains.',
    details: [
      'Driving digital transformation of asset and inventory tracking systems',
      'Delivered the Etisalat e& Smart Autonomous Store project',
      'Managing 20+ concurrent projects with teams of 30+ professionals',
      'Implementing AMR, ASRS, RFID, IoT, WMS, ITMS for cost reduction and scalability',
    ],
  },
  {
    period: 'Dec 2018 — 2022', tag: 'Growth', title: 'SPAN Group — Complete Journey', place: 'SPAN Trading L.L.C. · Dubai, UAE',
    summary: 'From Inventory Clerk to Project Manager through dedication and continuous learning.',
    details: [
      'Phase 1 (Dec 2018 – Mar 2020): Started as Inventory Clerk, promoted to Supervisor in 8 months, then Senior Supervisor, then Implementation Consultant',
      'Implemented S4Assets for 25+ clients; reduced manual labor by 30%',
      'Phase 2 (Apr 2020 – Present): Built leadership skills, took on larger projects, promoted to Project Manager after 2-3 years',
      'Achieved 50% reduction in manual effort and 35% increase in tracking accuracy',
    ],
  },
  {
    period: 'Jul 2018 — Nov 2018', tag: 'First Dubai Job', title: 'IT Manager', place: 'S*ace · Dubai, UAE',
    summary: 'First job in Dubai — secured within 10 days of arrival with no connections.',
    details: [
      'Secured 3 job offers within 10 days of landing in Dubai',
      'Expanded from a technical role to all IT and software operations',
      'Gained expertise in SAP Business One and led a HANA database migration',
      'Company closure led to the opportunity at SPAN Trading L.L.C.',
    ],
  },
  {
    period: 'Jun 2015 — Jun 2018', tag: 'Development', title: 'SAP HCM Consultant', place: 'ADP Private Limited · Hyderabad, India',
    summary: 'Transformative phase building SAP expertise, confidence, and communication skills.',
    details: [
      'Payroll functional support for US & Mexico clients across Client Champion, Interfaces, Projects, and ECHO teams',
      'Led requirement gathering, blueprinting, configuration, and testing',
      'Became a core member of the company Toastmasters club, developing public speaking and leadership skills',
      'Resigned without another job lined up — a bold decision that led to Dubai',
    ],
  },
  {
    period: 'Apr 2015 — May 2015', tag: 'First Job', title: 'Blitz Member', place: 'Practo Private Limited · Bangalore/Varanasi',
    summary: "First professional role helping expand Practo's network of registered doctors.",
    details: [
      'Gathered clinic information for the Practo platform',
      'Engaged healthcare professionals and encouraged registration',
      'Gained field exposure and client interaction skills',
    ],
  },
  {
    period: 'Jul 2011 — May 2015', tag: 'Education', title: 'Bachelor of Engineering', place: 'Technocrats Institute of Technology · Bhopal',
    summary: 'Electronics & Communication Engineering — academic excellence and personal growth.',
    details: [
      'Started college a week late, faced severe stage fear at first',
      'Became department topper in the first semester, then dropped and regained focus for three consecutive toppers terms',
      'Faced rejection from 20+ companies during placements due to communication barriers before landing ADP',
    ],
  },
  {
    period: '2008 — 2011', tag: 'Education', title: 'Higher Secondary Education', place: 'Patna, India',
    summary: 'First time leaving the village for studies — a transformative experience.',
    details: [
      'Struggled with English-medium instruction after studying in Hindi',
      'Fell seriously ill with jaundice, bedridden for 3 months, restarted studies with family support',
      'Took a gap year, then earned admission offers to Bhopal and Kolkata',
    ],
  },
  {
    period: '2004 — 2008', tag: 'Education', title: 'Secondary School Education', place: 'Village School · Bihar',
    summary: 'Academic awakening through the influence of an inspiring teacher.',
    details: [
      'Barely attended classes for the first two years',
      "Class IX: a teacher — Wasim Sir — saw potential and gave personal attention in Math, Physics, and Chemistry",
      'Achieved the highest marks in school, and chose Science with Math for an engineering path',
    ],
  },
  {
    period: '1999 — 2004', tag: 'Education', title: 'Primary School Education', place: 'Sareya Village, Bihar',
    summary: 'Foundation years in a simple village school with basic but effective education.',
    details: [
      'Completed Nursery to Grade 1 within a year; Grade 6 by 2004',
      'One school, two teachers, minimal resources — but an effective foundation',
      'Total school fees for the entire primary education: under $15',
    ],
  },
  {
    period: '1996 — 1998', tag: 'Early Learning', title: 'Early Education', place: 'Village Madrasa · Sareya Village, Bihar',
    summary: "Foundation learning through Islamic education and my mother's teachings.",
    details: [
      'Learned fundamentals of Islam and prayers from my mother, with no educated family members to lean on',
      'Attended the village madrasa; the teacher advised my parents to enroll me in formal school',
    ],
  },
  {
    period: 'November 1992', tag: 'Beginning', title: 'Where It Started', place: 'Sareya Village, Gopalganj, Bihar, India',
    summary: 'Humble beginnings in a small village that shaped my values and determination.',
    details: [
      'Second child and first son among six siblings in a rural setting where education was a distant dream for most families',
      'Sareya gradually became one of the most educated villages in the region — a transformation that opened doors for my generation',
    ],
  },
];
---
<BaseLayout title="My Journey" description="From a small village in Bihar to leading digital transformation projects in Dubai — the full story of Mohammad Parwez's professional and personal growth.">
  <section class="border-b border-ink-950/8 bg-brand-50/30 py-16">
    <div class="container-page max-w-3xl">
      <p class="eyebrow">The Full Story</p>
      <h1 class="mt-3 font-serif text-4xl font-semibold text-ink-950 sm:text-5xl">My Journey</h1>
      <p class="mt-5 text-ink-700">
        From a small village in Bihar to leading digital transformation projects in Dubai — this is the
        unfiltered version, milestone by milestone.
      </p>
    </div>
  </section>

  <section class="py-16">
    <div class="container-page max-w-3xl space-y-5">
      {stages.map((s) => (
        <details class="card group open:shadow-md p-6">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4">
            <div>
              <p class="eyebrow">{s.period} · {s.tag}</p>
              <h3 class="mt-1 font-serif text-lg font-semibold text-ink-950">{s.title}</h3>
              <p class="text-sm text-ink-500">{s.place}</p>
              <p class="mt-2 text-sm text-ink-700">{s.summary}</p>
            </div>
            <span class="mt-1 shrink-0 text-ink-400 transition-transform group-open:rotate-180">▾</span>
          </summary>
          <ul class="mt-4 list-disc space-y-1.5 border-t border-ink-950/8 pl-5 pt-4 text-sm text-ink-700">
            {s.details.map((d) => <li>{d}</li>)}
          </ul>
        </details>
      ))}
    </div>

    <div class="container-page mt-12 max-w-3xl">
      <div class="rounded-2xl bg-ink-950 p-8 text-center text-white">
        <h3 class="font-serif text-2xl font-semibold">Ready for the Next Challenge</h3>
        <p class="mx-auto mt-3 max-w-lg text-white/70">
          From a small village in Bihar to leading digital transformation projects in Dubai — my journey
          continues with a passion for innovation and excellence.
        </p>
        <a href="/contact" class="btn btn-secondary mt-6 border-white/20 bg-transparent text-white hover:bg-white hover:text-ink-950">Let's Connect</a>
      </div>
    </div>
  </section>
</BaseLayout>
