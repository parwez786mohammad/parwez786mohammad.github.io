---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuroraBackground from '../../components/AuroraBackground.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { readingTime, formatPostDate } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, allPosts: posts },
  }));
}

interface Props { post: CollectionEntry<'blog'>; allPosts: CollectionEntry<'blog'>[] }
const { post, allPosts } = Astro.props;
const { Content } = await post.render();
const data = post.data;

const related = allPosts
  .filter((p) => p.slug !== post.slug && p.data.category === data.category)
  .slice(0, 3);

const site = 'https://themohammadparwez.com';
const postUrl = `${site}/blog/${post.slug}/`;
const shareUrl = encodeURIComponent(postUrl);
const shareText = encodeURIComponent(data.title);
const shareLinks = [
  { label: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}` },
  { label: 'X', href: `https://x.com/intent/post?url=${shareUrl}&text=${shareText}` },
  { label: 'WhatsApp', href: `https://wa.me/?text=${shareText}%20${shareUrl}` },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.description,
  url: postUrl,
  mainEntityOfPage: postUrl,
  datePublished: data.pubDate.toISOString(),
  dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
  author: { '@id': `${site}/#person` },
  publisher: { '@id': `${site}/#person` },
  ...(data.heroImage && { image: new URL(data.heroImage, site).href }),
  keywords: data.tags.join(', '),
};
---
<BaseLayout
  title={data.title}
  description={data.description}
  image={data.heroImage}
  type="article"
  publishedTime={data.pubDate.toISOString()}
  modifiedTime={data.updatedDate?.toISOString()}
  schema={schema}
>
  <article>
    <section class="relative overflow-hidden border-b border-ink-950/8 bg-brand-50/30 py-14">
      <AuroraBackground />
      <div class="container-page max-w-2xl">
        <a href="/blog/" class="text-sm font-medium text-brand-700">← All Posts</a>
        <p class="eyebrow mt-4">{data.category}</p>
        <h1 class="mt-3 font-serif text-3xl font-semibold leading-tight text-ink-950 sm:text-4xl">{data.title}</h1>
        <div class="mt-5 flex flex-wrap items-center gap-4 text-sm text-ink-500">
          <time datetime={data.pubDate.toISOString()}>{formatPostDate(data.pubDate, 'long')}</time>
          <span aria-hidden="true">·</span>
          <span>{readingTime(post)}</span>
        </div>
      </div>
    </section>

    {data.heroImage && (
      <div class="container-page -mt-8 max-w-3xl">
        <img src={data.heroImage} alt={data.title} fetchpriority="high" class="w-full rounded-2xl border border-ink-950/8 object-cover shadow-lg" />
      </div>
    )}

    <section class="py-14">
      <div class="container-page max-w-2xl">
        <div class="prose-article">
          <Content />
        </div>

        <div class="mt-8 flex flex-wrap gap-2">
          {data.tags.map((t: string) => <span class="rounded-full bg-ink-950/5 px-3 py-1 text-xs text-ink-700">#{t}</span>)}
        </div>

        <div class="mt-8 flex flex-wrap items-center gap-3 border-y border-ink-950/8 py-5">
          <span class="text-sm font-medium text-ink-600">Share:</span>
          {shareLinks.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" class="rounded-full border border-ink-950/15 px-3 py-1.5 text-xs font-medium hover:border-ink-950/40">{s.label}</a>
          ))}
        </div>

        <a href="/about/" class="mt-8 flex items-center gap-4 rounded-2xl border border-ink-950/8 bg-ink-950/[0.02] p-6 transition-colors hover:border-ink-950/20">
          <img src="/images/profile/Profile1.jpg" alt="" width="56" height="56" loading="lazy" class="h-14 w-14 rounded-full object-cover" />
          <div>
            <p class="font-serif font-semibold text-ink-950">Mohammad Parwez</p>
            <p class="text-sm text-ink-600">PMP® Certified Project Manager · Warehouse &amp; Logistics Automation Expert</p>
            <p class="mt-1 text-sm font-semibold text-brand-700">More about me →</p>
          </div>
        </a>

        {data.category === 'Toastmasters' && (
          <a href="/toastmasters/" class="mt-4 flex items-center justify-between gap-4 rounded-2xl bg-ink-950 p-6 text-white">
            <span>
              <span class="block font-serif text-lg font-semibold">Follow my Toastmasters journey</span>
              <span class="mt-1 block text-sm text-white/70">Pathways progress, every speech, and the videos.</span>
            </span>
            <span aria-hidden="true" class="text-gold-400">→</span>
          </a>
        )}
      </div>
    </section>

    {related.length > 0 && (
      <section class="border-t border-ink-950/8 bg-ink-950/[0.02] py-14">
        <div class="container-page">
          <h2 class="font-serif text-2xl font-semibold text-ink-950">Related Articles</h2>
          <div class="mt-8 grid gap-6 md:grid-cols-3">
            {related.map((p) => (
              <a href={`/blog/${p.slug}/`} class="card p-5">
                <span class="eyebrow">{p.data.category}</span>
                <h3 class="mt-2 font-serif text-base font-semibold text-ink-950">{p.data.title}</h3>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
</BaseLayout>
