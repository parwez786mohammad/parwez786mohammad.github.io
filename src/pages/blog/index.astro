---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = [...new Set(posts.map((p) => p.data.category))];
---
<BaseLayout title="Blog" description="Writing on leadership, project management, warehouse automation, digital transformation, AI, Toastmasters, and personal growth by Mohammad Parwez.">
  <section class="border-b border-ink-950/8 bg-brand-50/30 py-16">
    <div class="container-page max-w-3xl">
      <p class="eyebrow">Writing</p>
      <h1 class="mt-3 font-serif text-4xl font-semibold text-ink-950 sm:text-5xl">Blog</h1>
      <p class="mt-5 text-ink-700">Notes on automation, leadership, AI, and everything in between.</p>
      <div class="mt-6 flex flex-wrap gap-2">
        <a href="/blog" class="rounded-full bg-ink-950 px-4 py-1.5 text-sm font-medium text-white">All</a>
        {categories.map((c) => (
          <a href={`/blog/category/${encodeURIComponent(c.toLowerCase().replace(/\s+/g, '-'))}`} class="rounded-full border border-ink-950/15 px-4 py-1.5 text-sm font-medium text-ink-700 hover:border-ink-950/40">{c}</a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-14">
    <div class="container-page grid gap-6 md:grid-cols-3">
      {posts.map((post) => (
        <a href={`/blog/${post.slug}`} class="card overflow-hidden">
          {post.data.heroImage && <img src={post.data.heroImage} alt={post.data.title} class="h-48 w-full object-cover" />}
          <div class="p-5">
            <span class="eyebrow">{post.data.category}</span>
            <h2 class="mt-2 font-serif text-lg font-semibold leading-snug text-ink-950">{post.data.title}</h2>
            <p class="mt-2 line-clamp-2 text-sm text-ink-600">{post.data.description}</p>
            <div class="mt-4 flex items-center justify-between text-xs text-ink-500">
              <span>{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
              <span>{post.data.readingTime}</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
