---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConstellationBackground from '../components/ConstellationBackground.astro';
---
<BaseLayout title="Contact" description="Get in touch with Mohammad Parwez for warehouse automation, digital transformation, and project management collaborations.">
  <section class="relative overflow-hidden border-b border-ink-950/8 bg-brand-50/30 py-16">
    <ConstellationBackground />
    <div class="container-page max-w-3xl">
      <p class="eyebrow">Get In Touch</p>
      <h1 class="mt-3 font-serif text-4xl font-semibold text-ink-950 sm:text-5xl">Let's Connect</h1>
      <p class="mt-5 text-ink-700">
        Whether you have a project idea, want to collaborate, or just want to compare notes on automation
        and AI — I'd love to hear from you.
      </p>
    </div>
  </section>

  <section class="py-16">
    <div class="container-page grid gap-12 lg:grid-cols-[1fr_1.3fr]">
      <div class="space-y-8">
        <div class="card p-6">
          <h2 class="font-serif text-base font-semibold text-ink-950">Location</h2>
          <p class="mt-2 text-sm text-ink-600">SPAN Trading L.L.C., Showroom 4, Nabooda Complex, Nad Al Hamad Road, Dubai, UAE</p>
        </div>
        <div class="card p-6">
          <h2 class="font-serif text-base font-semibold text-ink-950">Connect on Social</h2>
          <div class="mt-3 flex flex-wrap gap-3">
            <a href="https://www.linkedin.com/in/mohammad-parwez-18bb01a7/" target="_blank" rel="noopener" class="rounded-full border border-ink-950/15 px-4 py-1.5 text-sm font-medium hover:border-ink-950/40">LinkedIn</a>
            <a href="https://www.youtube.com/@TheMohammadParwez" target="_blank" rel="noopener" class="rounded-full border border-ink-950/15 px-4 py-1.5 text-sm font-medium hover:border-ink-950/40">YouTube</a>
            <a href="https://www.instagram.com/themohammadparwez.1611/" target="_blank" rel="noopener" class="rounded-full border border-ink-950/15 px-4 py-1.5 text-sm font-medium hover:border-ink-950/40">Instagram</a>
          </div>
        </div>
        <div class="card p-6">
          <h2 class="font-serif text-base font-semibold text-ink-950">📄 Request My CV</h2>
          <p class="mt-2 text-sm text-ink-600">Send a message below and check the CV box — I'll share a copy directly.</p>
        </div>
      </div>

      <div class="card p-8">
        <h2 class="font-serif text-xl font-semibold text-ink-950">Send a Message</h2>
        <form id="contact-form" action="https://formspree.io/f/xpwpbwen" method="POST" class="mt-6 space-y-5">
          <input type="hidden" name="_subject" value="New message from themohammadparwez.com" />
          <!-- Spam trap: hidden from people, filled in by bots; Formspree drops submissions that fill it. -->
          <div class="absolute -left-[9999px]" aria-hidden="true">
            <label for="website">Leave this field empty</label>
            <input id="website" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <div>
            <label for="name" class="text-sm font-medium text-ink-700">Your Name *</label>
            <input id="name" name="name" type="text" required autocomplete="name" class="mt-1.5 w-full rounded-lg border border-ink-950/15 px-4 py-2.5 text-sm focus:border-brand-500 focus:outline-none" />
          </div>
          <div>
            <label for="email" class="text-sm font-medium text-ink-700">Email Address *</label>
            <input id="email" name="_replyto" type="email" required autocomplete="email" class="mt-1.5 w-full rounded-lg border border-ink-950/15 px-4 py-2.5 text-sm focus:border-brand-500 focus:outline-none" />
          </div>
          <div>
            <label for="message" class="text-sm font-medium text-ink-700">Your Message *</label>
            <textarea id="message" name="message" rows="5" required class="mt-1.5 w-full rounded-lg border border-ink-950/15 px-4 py-2.5 text-sm focus:border-brand-500 focus:outline-none"></textarea>
          </div>
          <label class="flex items-center gap-2 text-sm text-ink-600">
            <input type="checkbox" name="cv_request" value="yes" class="rounded border-ink-950/20" />
            I'd like to request a copy of your CV.
          </label>
          <button type="submit" class="btn btn-primary w-full">Send Message</button>
          <p id="form-status" class="text-sm" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Submit in the background so visitors stay on the site and see a confirmation.
  // Without JavaScript the form still posts normally to Formspree.
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) {
      button.disabled = true;
      button.textContent = 'Sending…';
    }
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      if (status) {
        status.className = 'text-sm font-medium text-green-700';
        status.textContent = "Thanks — your message is on its way. I'll reply as soon as I can.";
      }
    } catch {
      if (status) {
        status.className = 'text-sm font-medium text-red-700';
        status.textContent = "Sorry, that didn't send. Please try again, or reach me on LinkedIn.";
      }
    } finally {
      if (button) {
        button.disabled = false;
        button.textContent = 'Send Message';
      }
    }
  });
</script>
