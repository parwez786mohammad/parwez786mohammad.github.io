---
import BaseLayout from '../layouts/BaseLayout.astro';

const timeline = [
  {
    period: '2022 — Present',
    title: 'Project Manager',
    org: 'SPAN Trading L.L.C., Dubai',
    tag: 'Current',
    points: [
      'Driving digital transformation of asset & inventory tracking systems',
      'Delivered the Etisalat e& Smart Autonomous Store — the first telecom-operated autonomous retail store globally',
      'Managing 20+ concurrent automation projects with teams of 30+ professionals',
      'Implementing AMR, ASRS, RFID, IoT, WMS, and ITMS solutions for cost reduction and scalability',
      'Driving operational efficiency improvements of 40-60% across projects',
    ],
  },
  {
    period: 'Dec 2018 — 2022',
    title: 'Inventory Clerk → Supervisor → Implementation Consultant → Project Manager',
    org: 'SPAN Trading L.L.C., Dubai',
    tag: 'Growth',
    points: [
      'Promoted to Supervisor after 8 months, then Senior Supervisor, then Implementation Consultant',
      'Implemented S4Assets (Asset Management System) for 25+ clients',
      'Reduced manual labor by 30% through workflow enhancements',
      'Officially promoted to Project Manager after 2-3 years of intensive training',
    ],
  },
  {
    period: 'Jul 2018 — Nov 2018',
    title: 'IT Manager',
    org: 'S*ace, Dubai',
    tag: 'First Dubai Role',
    points: [
      'Secured 3 job offers within 10 days of arriving in Dubai with no local connections',
      'Gained expertise in SAP Business One and led a HANA database migration',
    ],
  },
  {
    period: 'Jun 2015 — Jun 2018',
    title: 'SAP HCM Consultant',
    org: 'ADP Private Limited, Hyderabad',
    tag: 'Foundation',
    points: [
      'Delivered payroll functional support for US & Mexico clients',
      'Led requirement gathering, blueprinting, configuration, and testing',
      'Became a core member of the company Toastmasters club — the start of my public speaking journey',
    ],
  },
  {
    period: 'Jul 2011 — May 2015',
    title: 'B.E., Electronics & Communication Engineering',
    org: 'Technocrats Institute of Technology, Bhopal',
    tag: 'Education',
    points: [
      'Overcame early stage-fear to become a three-time semester topper',
      'Shifted focus to practical, industry-ready skills alongside coursework',
    ],
  },
];

const certifications = [
  { name: 'PMP®', body: 'Project Management Institute' },
  { name: 'PRINCE2®', body: 'Axelos' },
  { name: 'ITIL®', body: 'Axelos' },
];

const philosophy = [
  {
    title: 'Continuous Learning',
    text: 'From SAP to AI agents, the tools change every few years — the constant is staying a beginner on purpose.',
  },
  {
    title: 'Technology With Purpose',
    text: 'Automation is only worth deploying if it removes real friction for real people — not automation for its own sake.',
  },
  {
    title: 'Leadership Through Service',
    text: 'The best project managers make their teams' + "'" + ' jobs easier, not their own job look impressive.',
  },
];
---
<BaseLayout title="About Mohammad Parwez" description="From engineering in Bhopal to leading digital transformation projects in Dubai — the story, philosophy, and credentials behind Mohammad Parwez's work.">
  <section class="border-b border-ink-950/8 bg-brand-50/30 py-16">
    <div class="container-page grid gap-10 lg:grid-cols-[0.9fr_1.4fr] lg:items-center">
      <div class="mx-auto w-full max-w-xs overflow-hidden rounded-[1.5rem] border border-ink-950/10 shadow-lg">
        <img src="/images/profile/Profile2.png" alt="Mohammad Parwez" class="aspect-[4/5] w-full object-cover" />
      </div>
      <div>
        <p class="eyebrow">About Me</p>
        <h1 class="mt-3 font-serif text-4xl font-semibold text-ink-950 sm:text-5xl">Engineering, Automation, Leadership — and Everything In Between</h1>
        <p class="mt-5 text-ink-700">
          I'm Mohammad Parwez, a Project Manager at SPAN Trading L.L.C. in Dubai, specializing in warehouse
          &amp; logistics automation, asset tracking, and AI-driven digital transformation. Over 10+ years I've
          moved from hands-on implementation to leading multi-million-dirham automation programs — and I write
          about what I learn along the way.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container-page max-w-3xl">
      <h2 class="font-serif text-2xl font-semibold text-ink-950">My Story</h2>
      <div class="prose-article mt-5">
        <p>I am a Project Manager and Digital Transformation professional with a background in Electronics
        &amp; Communication Engineering. Originally from a small village in Bihar, India, my journey has been
        shaped by continuous learning, resilience, and a willingness to step beyond my comfort zone.</p>
        <p>After moving to the UAE, I built my career across inventory management, asset tracking, software
        implementation, and enterprise technology solutions, progressing through roles that provided both
        operational and technical experience.</p>
        <p>Today, I lead projects focused on digital transformation, warehouse automation, asset tracking,
        RFID, robotics, and AI-enabled solutions. Having worked from the operational level through to project
        leadership, I bring a practical, hands-on perspective to solving business challenges and delivering
        measurable results.</p>
        <p>Beyond work, I am passionate about technology, continuous learning, public speaking, and helping
        others grow. I believe that success is not defined by where we begin, but by our willingness to learn,
        adapt, and keep moving forward.</p>
      </div>
    </div>
  </section>

  <section class="border-t border-ink-950/8 bg-ink-950/[0.02] py-16">
    <div class="container-page">
      <h2 class="font-serif text-2xl font-semibold text-ink-950">Philosophy</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-3">
        {philosophy.map((p) => (
          <div class="card p-6">
            <h3 class="font-serif text-lg font-semibold text-ink-950">{p.title}</h3>
            <p class="mt-2 text-sm text-ink-600">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container-page">
      <h2 class="font-serif text-2xl font-semibold text-ink-950">Experience Timeline</h2>
      <div class="mt-10 space-y-8 border-l border-ink-950/10 pl-8">
        {timeline.map((t) => (
          <div class="relative">
            <span class="absolute -left-[2.35rem] top-1.5 h-3 w-3 rounded-full bg-brand-600 ring-4 ring-white"></span>
            <p class="eyebrow">{t.period} · {t.tag}</p>
            <h3 class="mt-1 font-serif text-lg font-semibold text-ink-950">{t.title}</h3>
            <p class="text-sm text-ink-500">{t.org}</p>
            <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-ink-700">
              {t.points.map((pt) => <li>{pt}</li>)}
            </ul>
          </div>
        ))}
      </div>

      <div class="mt-16">
        <h3 class="font-serif text-xl font-semibold text-ink-950">Certifications</h3>
        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          {certifications.map((c) => (
            <div class="card p-6 text-center">
              <p class="font-serif text-2xl font-semibold text-ink-950">{c.name}</p>
              <p class="mt-1 text-xs text-ink-500">{c.body}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="mt-12 rounded-2xl border border-ink-950/8 bg-brand-50/40 p-8 text-center">
        <p class="text-ink-700">Want the full story — from a village school in Bihar to Dubai's warehouses?</p>
        <a href="/journey" class="btn btn-primary mt-4">Read My Journey</a>
      </div>
    </div>
  </section>
</BaseLayout>
