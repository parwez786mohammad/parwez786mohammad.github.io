---
import BaseLayout from '../layouts/BaseLayout.astro';
import DriftParticlesBackground from '../components/DriftParticlesBackground.astro';

// Career timeline. `points` come from the original About page; `more` holds the extra detail that
// used to live only on the separate Journey page (merged here in Oct 2026, nothing dropped).
const career = [
  {
    period: '2022 — Present',
    title: 'Project Manager',
    org: 'SPAN Trading L.L.C., Dubai',
    tag: 'Current',
    summary: 'Leading automation and AI-driven digital transformation across diverse domains.',
    points: [
      'Driving digital transformation of asset & inventory tracking systems',
      'Delivered the Smart Autonomous Store for a leading telecom company in the UAE — the first telecom-operated autonomous retail store globally',
      'Managing 20+ concurrent automation projects with teams of 30+ professionals',
      'Implementing AMR, ASRS, RFID, IoT, WMS, and ITMS solutions for cost reduction and scalability',
      'Driving operational efficiency improvements of 40-60% across projects',
    ],
    more: [],
  },
  {
    period: 'Dec 2018 — 2022',
    title: 'Inventory Clerk → Supervisor → Implementation Consultant → Project Manager',
    org: 'SPAN Trading L.L.C., Dubai',
    tag: 'Growth',
    summary: 'From Inventory Clerk to Project Manager through dedication and continuous learning.',
    points: [
      'Promoted to Supervisor after 8 months, then Senior Supervisor, then Implementation Consultant',
      'Implemented S4Assets (Asset Management System) for 25+ clients',
      'Reduced manual labor by 30% through workflow enhancements',
      'Officially promoted to Project Manager after 2-3 years of intensive training',
    ],
    more: [
      'Phase 1 (Dec 2018 – Mar 2020): Started as Inventory Clerk, promoted to Supervisor in 8 months, then Senior Supervisor, then Implementation Consultant',
      'Phase 2 (Apr 2020 – Present): Built leadership skills, took on larger projects, promoted to Project Manager after 2-3 years',
      'Achieved 50% reduction in manual effort and 35% increase in tracking accuracy',
    ],
  },
  {
    period: 'Jul 2018 — Nov 2018',
    title: 'IT Manager',
    org: 'S*ace, Dubai',
    tag: 'First Dubai Role',
    summary: 'First job in Dubai — secured within 10 days of arrival with no connections.',
    points: [
      'Secured 3 job offers within 10 days of arriving in Dubai with no local connections',
      'Gained expertise in SAP Business One and led a HANA database migration',
    ],
    more: [
      'Expanded from a technical role to all IT and software operations',
      'Company closure led to the opportunity at SPAN Trading L.L.C.',
    ],
  },
  {
    period: 'Jun 2015 — Jun 2018',
    title: 'SAP HCM Consultant',
    org: 'ADP Private Limited, Hyderabad',
    tag: 'Foundation',
    summary: 'Transformative phase building SAP expertise, confidence, and communication skills.',
    points: [
      'Delivered payroll functional support for US & Mexico clients',
      'Led requirement gathering, blueprinting, configuration, and testing',
      'Became a core member of the company Toastmasters club — the start of my public speaking journey',
    ],
    more: [
      'Payroll functional support for US & Mexico clients across Client Champion, Interfaces, Projects, and ECHO teams',
      'Resigned without another job lined up — a bold decision that led to Dubai',
    ],
  },
  {
    period: 'Apr 2015 — May 2015',
    title: 'Blitz Member',
    org: 'Practo Private Limited, Bangalore/Varanasi',
    tag: 'First Job',
    summary: "First professional role helping expand Practo's network of registered doctors.",
    points: [
      'Gathered clinic information for the Practo platform',
      'Engaged healthcare professionals and encouraged registration',
      'Gained field exposure and client interaction skills',
    ],
    more: [],
  },
];

// Early-life chapters, from the former Journey page.
const journey = [
  {
    period: 'Jul 2011 — May 2015', tag: 'Education', title: 'Bachelor of Engineering', place: 'Technocrats Institute of Technology · Bhopal',
    summary: 'Electronics & Communication Engineering — academic excellence and personal growth.',
    details: [
      'Started college a week late, faced severe stage fear at first',
      'Became department topper in the first semester, then dropped and regained focus for three consecutive toppers terms',
      'Overcame early stage-fear to become a three-time semester topper',
      'Shifted focus to practical, industry-ready skills alongside coursework',
      'Faced rejection from 20+ companies during placements due to communication barriers before landing ADP',
    ],
  },
  {
    period: '2008 — 2011', tag: 'Education', title: 'Higher Secondary Education', place: 'Patna, India',
    summary: 'First time leaving the village for studies — a transformative experience.',
    details: [
      'Struggled with English-medium instruction after studying in Hindi',
      'Fell seriously ill with jaundice, bedridden for 3 months, restarted studies with family support',
      'Took a gap year, then earned admission offers to Bhopal and Kolkata',
    ],
  },
  {
    period: '2004 — 2008', tag: 'Education', title: 'Secondary School Education', place: 'Village School · Bihar',
    summary: 'Academic awakening through the influence of an inspiring teacher.',
    details: [
      'Barely attended classes for the first two years',
      'Class IX: a teacher — Wasim Sir — saw potential and gave personal attention in Math, Physics, and Chemistry',
      'Achieved the highest marks in school, and chose Science with Math for an engineering path',
    ],
  },
  {
    period: '1999 — 2004', tag: 'Education', title: 'Primary School Education', place: 'Sareya Village, Bihar',
    summary: 'Foundation years in a simple village school with basic but effective education.',
    details: [
      'Completed Nursery to Grade 1 within a year; Grade 6 by 2004',
      'One school, two teachers, minimal resources — but an effective foundation',
      'Total school fees for the entire primary education: under $15',
    ],
  },
  {
    period: '1996 — 1998', tag: 'Early Learning', title: 'Early Education', place: 'Village Madrasa · Sareya Village, Bihar',
    summary: "Foundation learning through Islamic education and my mother's teachings.",
    details: [
      'Learned fundamentals of Islam and prayers from my mother, with no educated family members to lean on',
      'Attended the village madrasa; the teacher advised my parents to enroll me in formal school',
    ],
  },
  {
    period: 'November 1992', tag: 'Beginning', title: 'Where It Started', place: 'Sareya Village, Gopalganj, Bihar, India',
    summary: 'Humble beginnings in a small village that shaped my values and determination.',
    details: [
      'Second child and first son among six siblings in a rural setting where education was a distant dream for most families',
      'Sareya gradually became one of the most educated villages in the region — a transformation that opened doors for my generation',
    ],
  },
];

const facts = [
  { value: 'PMP® · PRINCE2® · ITIL®', label: 'Certifications' },
  { value: 'Dubai, UAE', label: 'Based here since 2018' },
  { value: '20+ projects', label: 'Run concurrently' },
  { value: '30+ people', label: 'Teams led' },
];

const certifications = [
  { name: 'PMP®', body: 'Project Management Institute' },
  { name: 'PRINCE2®', body: 'Axelos' },
  { name: 'ITIL®', body: 'Axelos' },
];

const philosophy = [
  {
    title: 'Continuous Learning',
    text: 'From SAP to AI agents, the tools change every few years — the constant is staying a beginner on purpose.',
  },
  {
    title: 'Technology With Purpose',
    text: 'Automation is only worth deploying if it removes real friction for real people — not automation for its own sake.',
  },
  {
    title: 'Leadership Through Service',
    text: 'The best project managers make their teams' + "'" + ' jobs easier, not their own job look impressive.',
  },
];

const sections = [
  { id: 'story', label: 'My Story' },
  { id: 'career', label: 'Career' },
  { id: 'journey', label: 'My Journey' },
  { id: 'philosophy', label: 'Philosophy' },
];
---
<BaseLayout title="About Mohammad Parwez" description="From a small village in Bihar to leading digital transformation projects in Dubai — the story, career, philosophy, and credentials behind Mohammad Parwez's work.">
  <section class="relative overflow-hidden border-b border-ink-950/8 bg-brand-50/30 py-16">
    <DriftParticlesBackground />
    <div class="container-page grid gap-10 lg:grid-cols-[0.9fr_1.4fr] lg:items-center">
      <div class="mx-auto w-full max-w-xs overflow-hidden rounded-[1.5rem] border border-ink-950/10 shadow-lg">
        <img src="/images/profile/Profile2.jpg" alt="Mohammad Parwez" width="800" height="1012" fetchpriority="high" class="aspect-[4/5] w-full object-cover" />
      </div>
      <div>
        <p class="eyebrow">About Me</p>
        <h1 class="mt-3 font-serif text-4xl font-semibold text-ink-950 sm:text-5xl">Engineering, Automation, Leadership — and Everything In Between</h1>
        <p class="mt-5 text-ink-700">
          I'm Mohammad Parwez, a Project Manager at SPAN Trading L.L.C. in Dubai, specializing in warehouse
          &amp; logistics automation, asset tracking, and AI-driven digital transformation. Over 10+ years I've
          moved from hands-on implementation to leading multi-million-dirham automation programs — and I write
          about what I learn along the way.
        </p>
        <nav aria-label="On this page" class="mt-6 flex flex-wrap gap-2">
          {sections.map((s) => (
            <a href={`#${s.id}`} class="rounded-full border border-ink-950/15 bg-white px-4 py-1.5 text-sm font-medium text-ink-700 hover:border-ink-950/40">{s.label}</a>
          ))}
        </nav>
      </div>
    </div>
  </section>

  <section class="border-b border-ink-950/8 py-10">
    <div class="container-page">
      <dl class="grid grid-cols-2 gap-4 lg:grid-cols-4">
        {facts.map((f) => (
          <div class="rounded-2xl border border-ink-950/8 p-5">
            <dt class="text-xs text-ink-500">{f.label}</dt>
            <dd class="mt-1 font-serif text-lg font-semibold text-ink-950">{f.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section id="story" class="py-16">
    <div class="container-page max-w-3xl">
      <h2 class="font-serif text-2xl font-semibold text-ink-950">My Story</h2>
      <div class="prose-article mt-5">
        <p>I am a Project Manager and Digital Transformation professional with a background in Electronics
        &amp; Communication Engineering. Originally from a small village in Bihar, India, my journey has been
        shaped by continuous learning, resilience, and a willingness to step beyond my comfort zone.</p>
        <p>After moving to the UAE, I built my career across inventory management, asset tracking, software
        implementation, and enterprise technology solutions, progressing through roles that provided both
        operational and technical experience.</p>
        <p>Today, I lead projects focused on digital transformation, warehouse automation, asset tracking,
        RFID, robotics, and AI-enabled solutions. Having worked from the operational level through to project
        leadership, I bring a practical, hands-on perspective to solving business challenges and delivering
        measurable results.</p>
        <p>Beyond work, I am passionate about technology, continuous learning, public speaking, and helping
        others grow. I believe that success is not defined by where we begin, but by our willingness to learn,
        adapt, and keep moving forward.</p>
      </div>
    </div>
  </section>

  <section id="career" class="border-t border-ink-950/8 bg-ink-950/[0.02] py-16">
    <div class="container-page max-w-4xl">
      <h2 class="font-serif text-2xl font-semibold text-ink-950">Career</h2>
      <ol class="mt-10 space-y-10 border-l border-ink-950/10 pl-8">
        {career.map((t) => (
          <li class="relative">
            <span class="absolute -left-[2.35rem] top-1.5 h-3 w-3 rounded-full bg-brand-600 ring-4 ring-white" aria-hidden="true"></span>
            <p class="eyebrow">{t.period} · {t.tag}</p>
            <h3 class="mt-1 font-serif text-lg font-semibold text-ink-950">{t.title}</h3>
            <p class="text-sm text-ink-500">{t.org}</p>
            <p class="mt-2 text-sm italic text-ink-600">{t.summary}</p>
            <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-ink-700">
              {[...t.points, ...t.more].map((pt) => <li>{pt}</li>)}
            </ul>
          </li>
        ))}
      </ol>

      <div class="mt-16">
        <h3 class="font-serif text-xl font-semibold text-ink-950">Certifications</h3>
        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          {certifications.map((c) => (
            <div class="card p-6 text-center">
              <p class="font-serif text-2xl font-semibold text-ink-950">{c.name}</p>
              <p class="mt-1 text-xs text-ink-500">{c.body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="journey" class="py-16">
    <div class="container-page max-w-4xl">
      <p class="eyebrow">The Full Story</p>
      <h2 class="mt-3 font-serif text-2xl font-semibold text-ink-950">My Journey</h2>
      <p class="mt-3 max-w-2xl text-ink-700">
        From a small village in Bihar to leading digital transformation projects in Dubai — this is the
        unfiltered version, milestone by milestone. Open any chapter to read it.
      </p>
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        {journey.map((s) => (
          <details class="card group p-5 open:shadow-md">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-4">
              <div>
                <p class="eyebrow">{s.period} · {s.tag}</p>
                <h3 class="mt-1 font-serif text-lg font-semibold text-ink-950">{s.title}</h3>
                <p class="text-sm text-ink-500">{s.place}</p>
                <p class="mt-2 text-sm text-ink-700">{s.summary}</p>
              </div>
              <span class="mt-1 shrink-0 text-ink-400 transition-transform group-open:rotate-180" aria-hidden="true">▾</span>
            </summary>
            <ul class="mt-4 list-disc space-y-1.5 border-t border-ink-950/8 pl-5 pt-4 text-sm text-ink-700">
              {s.details.map((d) => <li>{d}</li>)}
            </ul>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section id="philosophy" class="border-t border-ink-950/8 bg-ink-950/[0.02] py-16">
    <div class="container-page">
      <h2 class="font-serif text-2xl font-semibold text-ink-950">Philosophy</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-3">
        {philosophy.map((p) => (
          <div class="card p-6">
            <h3 class="font-serif text-lg font-semibold text-ink-950">{p.title}</h3>
            <p class="mt-2 text-sm text-ink-600">{p.text}</p>
          </div>
        ))}
      </div>

      <div class="mt-12 rounded-2xl bg-ink-950 p-8 text-center text-white">
        <h2 class="font-serif text-2xl font-semibold">Ready for the Next Challenge</h2>
        <p class="mx-auto mt-3 max-w-lg text-white/70">
          From a small village in Bihar to leading digital transformation projects in Dubai — my journey
          continues with a passion for innovation and excellence.
        </p>
        <a href="/contact/" class="btn btn-secondary mt-6 border-white/20 bg-transparent text-white hover:bg-white hover:text-ink-950">Let's Connect</a>
      </div>
    </div>
  </section>
</BaseLayout>
