---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuroraBackground from '../../components/AuroraBackground.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, prev: projects[i - 1], next: projects[i + 1] },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  prev?: CollectionEntry<'projects'>;
  next?: CollectionEntry<'projects'>;
}
const { project, prev, next } = Astro.props;
const { Content } = await project.render();
const data = project.data;

const site = 'https://themohammadparwez.com';
const url = `${site}/projects/${project.slug}/`;

const glance = [
  { label: 'Client', value: data.client },
  { label: 'Period', value: data.period },
  { label: 'Status', value: data.status },
  { label: 'Type', value: data.caseStudyType },
].filter((g) => g.value);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.summary,
  url,
  mainEntityOfPage: url,
  author: { '@id': `${site}/#person` },
  ...(data.heroImage && { image: new URL(data.heroImage, site).href }),
};
---
<BaseLayout title={data.title} description={data.summary} image={data.heroImage} type="article" schema={schema}>
  <article>
    <section class="relative overflow-hidden border-b border-ink-950/8 bg-brand-50/30 py-16">
      <AuroraBackground />
      <div class="container-page max-w-3xl">
        <a href="/projects/" class="text-sm font-medium text-brand-700">← All Projects</a>
        <p class="eyebrow mt-4">{data.caseStudyType} · {data.status}</p>
        <h1 class="mt-3 font-serif text-3xl font-semibold text-ink-950 sm:text-4xl">{data.title}</h1>
        <p class="mt-4 text-ink-700">{data.summary}</p>
        <dl class="mt-6 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-ink-950/8 bg-ink-950/8 sm:grid-cols-4">
          {glance.map((g) => (
            <div class="bg-white/80 p-4">
              <dt class="text-xs text-ink-500">{g.label}</dt>
              <dd class="mt-1 text-sm font-semibold text-ink-900">{g.value}</dd>
            </div>
          ))}
        </dl>
        <div class="mt-4 flex flex-wrap gap-1.5">
          {data.technologies.map((t: string) => <span class="rounded-full bg-white px-3 py-1 text-xs font-medium text-ink-700 ring-1 ring-ink-950/10">{t}</span>)}
        </div>
      </div>
    </section>

    <section class="py-14">
      <div class="container-page grid gap-12 lg:grid-cols-[1fr_1.6fr]">
        <aside class="space-y-8 lg:sticky lg:top-24 lg:self-start">
          {data.businessProblem && (
            <div>
              <h2 class="font-serif text-lg font-semibold text-ink-950">Business Problem</h2>
              <p class="mt-2 text-sm text-ink-600">{data.businessProblem}</p>
            </div>
          )}
          {data.myRole && (
            <div>
              <h2 class="font-serif text-lg font-semibold text-ink-950">My Role</h2>
              <p class="mt-2 text-sm text-ink-600">{data.myRole}</p>
            </div>
          )}
          {data.solution && (
            <div>
              <h2 class="font-serif text-lg font-semibold text-ink-950">Solution</h2>
              <p class="mt-2 text-sm text-ink-600">{data.solution}</p>
            </div>
          )}
        </aside>

        <div class="prose-article">
          <Content />

          {data.challenges.length > 0 && (
            <>
              <h2>Challenges</h2>
              <ul>{data.challenges.map((c: string) => <li>{c}</li>)}</ul>
            </>
          )}

          {data.outcomes.length > 0 && (
            <>
              <h2>Outcome</h2>
              <ul>{data.outcomes.map((o: string) => <li>{o}</li>)}</ul>
            </>
          )}

          {data.keyLearnings.length > 0 && (
            <>
              <h2>Key Learning</h2>
              <div class="not-prose grid gap-3 sm:grid-cols-2">
                {data.keyLearnings.map((l: string) => (
                  <div class="card p-4 text-sm text-ink-700">{l}</div>
                ))}
              </div>
            </>
          )}
        </div>
      </div>
    </section>

    <section class="border-t border-ink-950/8 py-14">
      <div class="container-page">
        <nav aria-label="More case studies" class="grid gap-4 sm:grid-cols-2">
          {prev ? (
            <a href={`/projects/${prev.slug}/`} class="card p-5">
              <span class="text-xs text-ink-500">← Previous case study</span>
              <span class="mt-1 block font-serif font-semibold text-ink-950">{prev.data.title}</span>
            </a>
          ) : <span class="hidden sm:block"></span>}
          {next && (
            <a href={`/projects/${next.slug}/`} class="card p-5 sm:text-right">
              <span class="text-xs text-ink-500">Next case study →</span>
              <span class="mt-1 block font-serif font-semibold text-ink-950">{next.data.title}</span>
            </a>
          )}
        </nav>
        <div class="mt-10 text-center">
          <a href="/contact/" class="btn btn-primary">Discuss a Similar Project</a>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
