---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TestimonialMarquee from '../../components/TestimonialMarquee.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const types = ['All', ...new Set(projects.map((p) => p.data.caseStudyType))];
---
<BaseLayout title="Projects & Case Studies" description="Featured projects and consulting-style case studies in warehouse automation, RFID, asset tracking, and digital transformation led by Mohammad Parwez.">
  <section class="border-b border-ink-950/8 bg-brand-50/30 py-16">
    <div class="container-page max-w-3xl">
      <p class="eyebrow">Case Studies</p>
      <h1 class="mt-3 font-serif text-4xl font-semibold text-ink-950 sm:text-5xl">Projects &amp; Case Studies</h1>
      <p class="mt-5 text-ink-700">
        Each project below is written up like a consulting engagement — the business problem, the solution,
        the challenges, the outcome, and what I learned along the way.
      </p>
    </div>
  </section>

  <section class="py-14">
    <div class="container-page">
      <div id="filters" class="flex flex-wrap gap-2">
        {types.map((t, i) => (
          <button data-filter={t} class:list={["filter-btn rounded-full border px-4 py-1.5 text-sm font-medium transition-colors", i === 0 ? "border-ink-950 bg-ink-950 text-white" : "border-ink-950/15 text-ink-700 hover:border-ink-950/40"]}>{t}</button>
        ))}
      </div>

      <div id="project-grid" class="mt-10 grid gap-6 md:grid-cols-2">
        {projects.map((p) => (
          <a href={`/projects/${p.slug}`} data-type={p.data.caseStudyType} class="project-card card flex flex-col p-6">
            <div class="flex items-center justify-between gap-3">
              <span class="eyebrow">{p.data.caseStudyType}</span>
              <span class="rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-semibold text-brand-700">{p.data.status}</span>
            </div>
            <h3 class="mt-3 font-serif text-xl font-semibold text-ink-950">{p.data.title}</h3>
            <p class="mt-2 flex-1 text-sm text-ink-600">{p.data.summary}</p>
            <div class="mt-4 flex flex-wrap gap-1.5">
              {p.data.technologies.slice(0, 4).map((tech: string) => <span class="rounded-full bg-ink-950/5 px-2.5 py-1 text-xs text-ink-700">{tech}</span>)}
            </div>
            <span class="mt-4 text-sm font-semibold text-brand-700">Read case study →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <TestimonialMarquee />
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLAnchorElement>('.project-card');
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.classList.remove('border-ink-950', 'bg-ink-950', 'text-white'));
      buttons.forEach((b) => b.classList.add('border-ink-950/15', 'text-ink-700'));
      btn.classList.add('border-ink-950', 'bg-ink-950', 'text-white');
      btn.classList.remove('border-ink-950/15', 'text-ink-700');

      const filter = btn.dataset.filter;
      cards.forEach((card) => {
        const show = filter === 'All' || card.dataset.type === filter;
        card.style.display = show ? '' : 'none';
      });
    });
  });
</script>
