---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuroraBackground from '../../components/AuroraBackground.astro';
import { getCollection } from 'astro:content';
import { pathwayProgress, formatDate } from '../../lib/toastmasters';
import { headlineOutcome } from '../../lib/projects';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const tm = pathwayProgress(await getCollection('speeches'));
const award = tm.awarded[0];
---
<BaseLayout title="Projects & Case Studies" description="Featured projects and consulting-style case studies in warehouse automation, RFID, asset tracking, and digital transformation led by Mohammad Parwez — plus his Toastmasters leadership journey.">
  <section class="relative overflow-hidden border-b border-ink-950/8 bg-brand-50/30 py-16">
    <AuroraBackground />
    <div class="container-page max-w-3xl">
      <p class="eyebrow">Case Studies</p>
      <h1 class="mt-3 font-serif text-4xl font-semibold text-ink-950 sm:text-5xl">Projects &amp; Case Studies</h1>
      <p class="mt-5 text-ink-700">
        Each project below is written up like a consulting engagement — the business problem, the solution,
        the challenges, the outcome, and what I learned along the way.
      </p>
    </div>
  </section>

  <section class="py-14">
    <div class="container-page">
      <h2 class="sr-only">Case studies</h2>
      <div class="grid gap-6 md:grid-cols-2">
        {projects.map((p) => {
          const result = headlineOutcome(p.data.outcomes);
          return (
            <a href={`/projects/${p.slug}/`} class="card flex flex-col p-6">
              <div class="flex items-center justify-between gap-3">
                <span class="eyebrow">{p.data.caseStudyType}{p.data.period && ` · ${p.data.period}`}</span>
                <span class="shrink-0 rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-semibold text-brand-700">{p.data.status}</span>
              </div>
              <h3 class="mt-3 font-serif text-xl font-semibold text-ink-950">{p.data.title}</h3>
              <p class="mt-2 flex-1 text-sm text-ink-600">{p.data.summary}</p>
              {result && <p class="mt-4 border-t border-ink-950/8 pt-3 text-sm font-semibold text-ink-950">{result}</p>}
              <div class="mt-4 flex flex-wrap gap-1.5">
                {p.data.technologies.slice(0, 4).map((tech: string) => <span class="rounded-full bg-ink-950/5 px-2.5 py-1 text-xs text-ink-700">{tech}</span>)}
              </div>
              <span class="mt-4 text-sm font-semibold text-brand-700">Read case study →</span>
            </a>
          );
        })}
      </div>

      <div class="mt-14 grid gap-8 rounded-3xl bg-ink-950 p-8 text-white sm:p-10 lg:grid-cols-[1.3fr_1fr] lg:items-center">
        <div>
          <p class="eyebrow !text-gold-400">Beyond the day job · Toastmasters</p>
          <h2 class="mt-3 font-serif text-2xl font-semibold sm:text-3xl">Dynamic Leadership Path</h2>
          <p class="mt-3 max-w-xl text-sm text-white/70">
            DSO Toastmasters Club, Dubai. Speeches, evaluations and meeting roles that sharpen the structured
            thinking, clear communication and honest feedback I use with project teams every day.
          </p>
          {award && (
            <p class="mt-4 inline-block rounded-full bg-gold-400/20 px-3 py-1 text-xs font-semibold text-gold-400">
              🏆 {award.data.award} · {award.data.projectName}{award.data.date && `, ${formatDate(award.data.date)}`}
            </p>
          )}
          <div class="mt-6">
            <a href="/toastmasters/" class="btn btn-secondary border-white/20 bg-transparent text-white hover:bg-white hover:text-ink-950">See my Toastmasters journey</a>
          </div>
        </div>
        <div class="space-y-3">
          <div class="flex justify-between text-sm text-white/75">
            <span>Level {tm.level}</span>
            <span>{tm.completed} of {tm.total} projects</span>
          </div>
          <div class="h-2 overflow-hidden rounded-full bg-white/15" role="progressbar" aria-valuemin="0" aria-valuemax={tm.total} aria-valuenow={tm.completed} aria-label={`Level ${tm.level} progress`}>
            <div class="h-full rounded-full bg-gold-400" style={`width: ${tm.total ? (tm.completed / tm.total) * 100 : 0}%`}></div>
          </div>
          {tm.latest && (
            <div class="flex justify-between gap-4 text-sm text-white/75">
              <span>Latest: &ldquo;{tm.latest.data.speechTitle ?? tm.latest.data.projectName}&rdquo;</span>
              {tm.latest.data.date && <span class="shrink-0">{tm.latest.data.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' })}</span>}
            </div>
          )}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
