---
import BaseLayout from '../../layouts/BaseLayout.astro';

const categories = ['Toastmasters', 'Project Management', 'AI', 'Leadership', 'Book Reviews', 'Technology Insights'];

// Add real videos here as they're published — id is the YouTube video ID.
const videos: { title: string; category: string; id: string }[] = [];
---
<BaseLayout title="Video Centre" description="Mohammad Parwez's video library covering Toastmasters, project management, AI, leadership, book reviews, and technology insights.">
  <section class="border-b border-ink-950/8 bg-brand-50/30 py-16">
    <div class="container-page max-w-3xl">
      <p class="eyebrow">Watch</p>
      <h1 class="mt-3 font-serif text-4xl font-semibold text-ink-950 sm:text-5xl">Video Centre</h1>
      <p class="mt-5 text-ink-700">
        Video content on Toastmasters, project management, AI, leadership, book reviews, and technology
        insights — embedded directly from
        <a href="https://www.youtube.com/@TheMohammadParwez" target="_blank" rel="noopener" class="font-semibold text-brand-700">my YouTube channel</a>.
      </p>
      <div class="mt-6 flex flex-wrap gap-2">
        {categories.map((c) => <span class="rounded-full border border-ink-950/15 px-4 py-1.5 text-sm font-medium text-ink-700">{c}</span>)}
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container-page">
      {videos.length === 0 ? (
        <div class="rounded-2xl border border-dashed border-ink-950/15 p-14 text-center">
          <h3 class="font-serif text-xl font-semibold text-ink-950">🎬 New videos in production</h3>
          <p class="mx-auto mt-3 max-w-md text-ink-600">
            I'm currently producing video content across these categories. Subscribe on YouTube to be first
            to know when new episodes go live.
          </p>
          <a href="https://www.youtube.com/@TheMohammadParwez" target="_blank" rel="noopener" class="btn btn-primary mt-6">Subscribe on YouTube</a>
        </div>
      ) : (
        <div class="grid gap-6 md:grid-cols-3">
          {videos.map((v) => (
            <div class="card overflow-hidden">
              <div class="aspect-video w-full">
                <iframe class="h-full w-full" src={`https://www.youtube.com/embed/${v.id}`} title={v.title} loading="lazy" allowfullscreen></iframe>
              </div>
              <div class="p-4">
                <span class="eyebrow">{v.category}</span>
                <h3 class="mt-1 font-serif text-base font-semibold text-ink-950">{v.title}</h3>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
