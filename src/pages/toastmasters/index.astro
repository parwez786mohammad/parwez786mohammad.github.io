---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const speeches = (await getCollection('speeches')).sort((a, b) => {
  if (a.data.date && b.data.date) return b.data.date.valueOf() - a.data.date.valueOf();
  if (a.data.date) return -1;
  if (b.data.date) return 1;
  return 0;
});

// The Dynamic Leadership Path curriculum. Level 1's projects are known; levels 2-5
// will get real project names added here as they're reached. Individual speech
// records (title, date, video) live in src/content/speeches/ and are matched in
// by pathwayLevel + projectNumber, so new speeches never require a page edit.
const pathwayLevels = [
  {
    level: 1,
    projects: [
      { number: 1, name: 'Ice Breaker' },
      { number: 2, name: 'Evaluation and Feedback' },
      { number: 3, name: 'Researching and Presenting' },
    ],
  },
  { level: 2, projects: [] },
  { level: 3, projects: [] },
  { level: 4, projects: [] },
  { level: 5, projects: [] },
];

function findSpeech(level: number, projectNumber: number) {
  return speeches.find((s) => s.data.pathwayLevel === level && s.data.projectNumber === projectNumber);
}

function getYouTubeId(url?: string) {
  if (!url) return null;
  const match = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([\w-]{11})/);
  return match ? match[1] : null;
}

function isVideoFile(url?: string) {
  return !!url && !getYouTubeId(url) && /\.(mp4|webm|mov)$/i.test(url);
}

const leadershipRoles = [
  { role: 'Table Topics Master', desc: 'Crafting impromptu speaking prompts and running the Table Topics segment of club meetings.' },
  { role: 'Evaluator', desc: 'Giving structured, constructive feedback to fellow speakers to help sharpen their delivery.' },
  { role: 'General Evaluator / Meeting Roles', desc: 'Overseeing meeting flow, timing, and overall quality as part of the leadership track.' },
];
---
<BaseLayout title="Toastmasters Journey" description="Mohammad Parwez's Toastmasters journey through the Dynamic Leadership Path — Pathways progress, speeches, and leadership roles.">
  <section class="border-b border-ink-950/8 bg-brand-50/30 py-16">
    <div class="container-page max-w-3xl">
      <p class="eyebrow">Public Speaking &amp; Leadership</p>
      <h1 class="mt-3 font-serif text-4xl font-semibold text-ink-950 sm:text-5xl">Toastmasters Journey</h1>
      <p class="mt-5 text-ink-700">
        My public speaking journey started at a company Toastmasters club during my time at ADP, and continues
        today as a member of <strong>DSO Toastmasters Club</strong>. It's where I practice the leadership skills
        I use every day on projects — structured thinking, clear communication, and giving honest feedback.
      </p>
      <div class="mt-6 inline-flex items-center gap-2 rounded-full border border-brand-200 bg-white px-4 py-2 text-sm font-medium text-brand-700">
        🎯 Currently pursuing: <strong>Dynamic Leadership Path</strong> (Toastmasters Pathways)
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container-page grid gap-10 lg:grid-cols-3">
      <div class="card p-6">
        <h3 class="font-serif text-lg font-semibold text-ink-950">Club Membership</h3>
        <p class="mt-2 text-sm text-ink-600">Active member of DSO Toastmasters Club, Dubai.</p>
      </div>
      <div class="card p-6">
        <h3 class="font-serif text-lg font-semibold text-ink-950">Speaking Journey</h3>
        <p class="mt-2 text-sm text-ink-600">From first-job stage fear to leading meetings and delivering structured speeches with purpose.</p>
      </div>
      <div class="card p-6">
        <h3 class="font-serif text-lg font-semibold text-ink-950">Leadership Development</h3>
        <p class="mt-2 text-sm text-ink-600">Practicing evaluation, timing, and meeting leadership roles alongside project leadership at work.</p>
      </div>
    </div>
  </section>

  <!-- Pathways Progress -->
  <section class="border-t border-ink-950/8 bg-ink-950/[0.02] py-16">
    <div class="container-page max-w-3xl">
      <p class="eyebrow">Pathways Progress</p>
      <h2 class="mt-3 font-serif text-2xl font-semibold text-ink-950">Dynamic Leadership Path</h2>
      <p class="mt-3 text-sm text-ink-600">
        Five levels of projects building speaking, evaluation, mentorship, and leadership skills — this is where
        I track progress level by level.
      </p>

      <div class="mt-10 space-y-8 border-l border-ink-950/10 pl-8">
        {pathwayLevels.map((lvl) => {
          const isActive = lvl.projects.length > 0;
          return (
            <div class="relative">
              <span class:list={[
                'absolute -left-[2.35rem] top-1 h-3 w-3 rounded-full ring-4 ring-white',
                isActive ? 'bg-brand-600' : 'bg-ink-950/15',
              ]} />
              <p class="eyebrow">Level {lvl.level}</p>

              {lvl.projects.length > 0 ? (
                <div class="mt-3 space-y-3">
                  {lvl.projects.map((p) => {
                    const speech = findSpeech(lvl.level, p.number);
                    const status = speech?.data.status ?? 'Upcoming';
                    return (
                      <div class="card flex flex-wrap items-center justify-between gap-3 p-4">
                        <div>
                          <p class="text-sm font-semibold text-ink-950">Project {p.number}: {p.name}</p>
                          {speech?.data.speechTitle && (
                            <p class="mt-1 text-sm text-ink-600">Speech: &ldquo;{speech.data.speechTitle}&rdquo;</p>
                          )}
                        </div>
                        <span class:list={[
                          'shrink-0 rounded-full px-3 py-1 text-xs font-semibold',
                          status === 'Completed' ? 'bg-brand-50 text-brand-700' : 'bg-ink-950/5 text-ink-600',
                        ]}>{status}</span>
                      </div>
                    );
                  })}
                </div>
              ) : (
                <div class="mt-3 rounded-xl border border-dashed border-ink-950/15 p-4 text-sm text-ink-500">
                  Future projects — details coming as I progress through this level.
                </div>
              )}
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Speech Library -->
  <section class="py-16">
    <div class="container-page">
      <h2 class="font-serif text-2xl font-semibold text-ink-950">Speech Library</h2>
      {speeches.length === 0 ? (
        <div class="mt-6 rounded-2xl border border-dashed border-ink-950/15 p-10 text-center">
          <p class="text-ink-600">Speech library coming soon — recordings and write-ups will be added here as they're delivered.</p>
        </div>
      ) : (
        <div class="mt-8 grid gap-6 md:grid-cols-3">
          {speeches.map((s) => {
            const ytId = getYouTubeId(s.data.videoUrl);
            const upload = isVideoFile(s.data.videoUrl);
            return (
              <div class="card overflow-hidden">
                {ytId ? (
                  <div class="aspect-video w-full">
                    <iframe class="h-full w-full" src={`https://www.youtube.com/embed/${ytId}`} title={s.data.speechTitle ?? s.data.projectName} loading="lazy" allowfullscreen />
                  </div>
                ) : upload ? (
                  <video controls class="aspect-video w-full bg-ink-950 object-cover" src={s.data.videoUrl} />
                ) : (
                  <div class="grid aspect-video w-full place-items-center bg-ink-950/5 text-sm text-ink-400">🎥 Video coming soon</div>
                )}
                <div class="p-5">
                  <p class="eyebrow">Level {s.data.pathwayLevel}{s.data.projectNumber && ` · Project ${s.data.projectNumber}`}: {s.data.projectName}</p>
                  <h3 class="mt-2 font-serif text-lg font-semibold text-ink-950">{s.data.speechTitle ?? s.data.projectName}</h3>
                  <p class="mt-2 text-xs text-ink-500">
                    {s.data.date ? s.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'Date TBD'}
                    {s.data.eventClub && ` · ${s.data.eventClub}`}
                  </p>
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>
  </section>

  <section class="border-t border-ink-950/8 bg-ink-950/[0.02] py-16">
    <div class="container-page">
      <h2 class="font-serif text-2xl font-semibold text-ink-950">Leadership Experiences</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-3">
        {leadershipRoles.map((r) => (
          <div class="card p-6">
            <h3 class="font-serif text-base font-semibold text-ink-950">{r.role}</h3>
            <p class="mt-2 text-sm text-ink-600">{r.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container-page max-w-2xl">
      <h2 class="font-serif text-2xl font-semibold text-ink-950">Table Topics</h2>
      <p class="mt-4 text-ink-700">
        Table Topics is where impromptu speaking gets real — no prep, one minute, whatever question lands.
        It's taught me more about staying composed under pressure than almost any project fire drill.
        A running favorite: framing an answer as a mini story instead of a list of points — it almost always
        lands better with the room.
      </p>
    </div>
  </section>
</BaseLayout>
