---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources');
const categories = [...new Set(resources.map((r) => r.data.category))];
---
<BaseLayout title="Resources" description="Free downloadable templates for project managers — BRD, FSD, risk register, governance, lessons learned, and AI prompt collections by Mohammad Parwez.">
  <section class="border-b border-ink-950/8 bg-brand-50/30 py-16">
    <div class="container-page max-w-3xl">
      <p class="eyebrow">Free Downloads</p>
      <h1 class="mt-3 font-serif text-4xl font-semibold text-ink-950 sm:text-5xl">Resources</h1>
      <p class="mt-5 text-ink-700">
        Templates and tools I actually use, cleaned up for you to download and adapt on your own projects.
      </p>
    </div>
  </section>

  <section class="py-16">
    <div class="container-page space-y-12">
      {categories.map((cat) => (
        <div>
          <h2 class="font-serif text-2xl font-semibold text-ink-950">{cat}</h2>
          <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {resources.filter((r) => r.data.category === cat).map((r) => (
              <a href={r.data.fileUrl} download class="card flex flex-col p-6">
                <span class="eyebrow">{r.data.fileType}</span>
                <h3 class="mt-2 font-serif text-lg font-semibold text-ink-950">{r.data.title}</h3>
                <p class="mt-2 flex-1 text-sm text-ink-600">{r.data.description}</p>
                <span class="mt-4 text-sm font-semibold text-brand-700">Download →</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
