---
import type { CollectionEntry } from 'astro:content';

export interface Props {
  testimonial: CollectionEntry<'testimonials'>;
  class?: string;
}

const { testimonial: t, class: className = '' } = Astro.props;
const isLong = t.data.quote.length > 140;
---
<div
  class={`testimonial-card card relative flex flex-col items-center p-6 text-center ${className}`}
  data-quote={t.data.quote}
  data-name={t.data.name}
  data-role={t.data.role}
  data-org={t.data.organization ?? ''}
  data-avatar={t.data.avatar ?? ''}
  data-category={t.data.category}
>
  <span class="absolute right-4 top-4 rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-semibold text-brand-700">{t.data.category}</span>
  {t.data.avatar ? (
    <img src={t.data.avatar} alt={t.data.name} class="h-20 w-20 rounded-full object-cover ring-4 ring-brand-50" />
  ) : (
    <div class="grid h-20 w-20 place-items-center rounded-full bg-brand-50 font-serif text-xl font-semibold text-brand-700 ring-4 ring-brand-50">
      {t.data.name.charAt(0)}
    </div>
  )}
  <p class="mt-4 line-clamp-3 text-sm leading-relaxed text-ink-700">&ldquo;{t.data.quote}&rdquo;</p>
  {isLong && (
    <button type="button" class="read-more-btn mt-1 text-xs font-semibold text-brand-700 hover:underline">
      Read full testimonial →
    </button>
  )}
  <p class="mt-3 text-sm font-semibold text-ink-950">{t.data.name}</p>
  <p class="mt-0.5 text-xs text-ink-500">{t.data.role}{t.data.organization ? ` · ${t.data.organization}` : ''}</p>
</div>
