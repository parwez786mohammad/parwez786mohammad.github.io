---
// Subtle drifting gradient-blob background. Absolutely positioned behind hero content —
// place as the first child inside a section with `relative overflow-hidden`.
// Respects prefers-reduced-motion.
---
<div class="aurora-bg" aria-hidden="true">
  <span></span>
  <span></span>
  <span></span>
</div>

<style>
  .aurora-bg {
    position: absolute;
    inset: -20%;
    z-index: -1;
    filter: blur(60px);
    pointer-events: none;
  }
  .aurora-bg span {
    position: absolute;
    border-radius: 9999px;
    opacity: 0.35;
  }
  .aurora-bg span:nth-child(1) {
    width: 50%; height: 60%; left: -5%; top: -10%;
    background: radial-gradient(circle, #59b0ff, transparent 70%);
    animation: aurora-float-1 16s ease-in-out infinite;
  }
  .aurora-bg span:nth-child(2) {
    width: 45%; height: 50%; right: -10%; top: 5%;
    background: radial-gradient(circle, #e8c27a, transparent 70%);
    animation: aurora-float-2 20s ease-in-out infinite;
  }
  .aurora-bg span:nth-child(3) {
    width: 40%; height: 45%; left: 20%; bottom: -15%;
    background: radial-gradient(circle, #2f8eff, transparent 70%);
    animation: aurora-float-3 18s ease-in-out infinite;
  }
  @keyframes aurora-float-1 { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(6%,8%) scale(1.12); } }
  @keyframes aurora-float-2 { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(-8%,4%) scale(0.92); } }
  @keyframes aurora-float-3 { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(4%,-6%) scale(1.08); } }

  @media (prefers-reduced-motion: reduce) {
    .aurora-bg span { animation: none; }
  }
</style>
