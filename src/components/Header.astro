---
import { navGroups, isActive } from '../lib/nav';

const path = Astro.url.pathname;
---
<header class="sticky top-0 z-50 border-b border-ink-950/8 bg-white/85 backdrop-blur-md">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex shrink-0 items-center gap-2.5 font-serif text-lg font-semibold text-ink-950">
      <span class="flex h-8 w-8 items-center justify-center rounded-full bg-ink-950 font-mono text-xs font-bold text-white">MP</span>
      <span class="hidden whitespace-nowrap sm:inline">Mohammad Parwez</span>
    </a>

    <nav aria-label="Main" class="hidden items-center gap-1 lg:flex">
      {navGroups.map((group) => {
        const active = group.items.some((item) => isActive(path, item.href));
        return group.items.length === 1 ? (
          <a
            href={group.items[0].href}
            aria-current={active ? 'page' : undefined}
            class:list={[
              'rounded-full px-3.5 py-2 text-sm font-medium transition-colors',
              active ? 'bg-ink-950 text-white' : 'text-ink-700 hover:bg-ink-950/5 hover:text-ink-950',
            ]}
          >
            {group.label}
          </a>
        ) : (
          <div class="nav-group relative">
            <button
              type="button"
              class:list={[
                'nav-trigger flex items-center gap-1 rounded-full px-3.5 py-2 text-sm font-medium transition-colors',
                active ? 'bg-ink-950 text-white' : 'text-ink-700 hover:bg-ink-950/5 hover:text-ink-950',
              ]}
              aria-expanded="false"
              aria-haspopup="true"
            >
              {group.label}
              <svg class="h-3 w-3 transition-transform" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" /></svg>
            </button>
            <div class="nav-menu absolute left-0 top-full pt-2">
              <div class="w-72 rounded-2xl border border-ink-950/8 bg-white p-2 shadow-[0_16px_40px_rgba(11,15,20,0.14)]">
                {group.items.map((item) => (
                  <a
                    href={item.href}
                    aria-current={isActive(path, item.href) ? 'page' : undefined}
                    class:list={['block rounded-xl px-3 py-2.5 hover:bg-brand-50', isActive(path, item.href) && 'bg-brand-50']}
                  >
                    <span class="block text-sm font-semibold text-ink-950">{item.label}</span>
                    <span class="block text-xs text-ink-500">{item.description}</span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        );
      })}
    </nav>

    <div class="flex items-center gap-3">
      <a href="/contact/" class="btn btn-primary hidden whitespace-nowrap sm:inline-flex">Let's Talk</a>
      <button
        id="menu-btn"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="grid h-10 w-10 place-items-center rounded-full border border-ink-950/10 lg:hidden"
      >
        <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" aria-label="Main" class="hidden max-h-[calc(100vh-4rem)] overflow-y-auto border-t border-ink-950/8 bg-white lg:hidden">
    <div class="container-page flex flex-col py-3">
      {navGroups.map((group) => (
        <div class="py-1">
          <p class="px-3 pb-1 pt-2 font-mono text-[0.68rem] uppercase tracking-[0.16em] text-ink-400">{group.label}</p>
          {group.items.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(path, item.href) ? 'page' : undefined}
              class:list={[
                'block rounded-lg px-3 py-2.5 text-sm font-medium',
                isActive(path, item.href) ? 'bg-brand-50 text-brand-700' : 'text-ink-800 hover:bg-ink-950/5',
              ]}
            >
              {item.label}
            </a>
          ))}
        </div>
      ))}
      <a href="/contact/" class="btn btn-primary mt-3 w-full">Let's Talk</a>
    </div>
  </nav>
</header>

<style>
  /* Toggled with a class, not the `hidden` attribute: the menu's own display rules would beat [hidden]. */
  .nav-menu {
    display: none;
  }
  .nav-group:hover .nav-menu,
  .nav-group.is-open .nav-menu {
    display: block;
  }
  .nav-group:hover .nav-trigger svg,
  .nav-group.is-open .nav-trigger svg {
    transform: rotate(180deg);
  }
</style>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  function setMobileMenu(open: boolean) {
    menu?.classList.toggle('hidden', !open);
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    btn?.setAttribute('aria-expanded', String(open));
    btn?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  }

  btn?.addEventListener('click', () => setMobileMenu(menu?.classList.contains('hidden') ?? false));

  const groups = document.querySelectorAll<HTMLElement>('.nav-group');

  function closeGroups(except?: HTMLElement) {
    groups.forEach((g) => {
      if (g === except) return;
      g.classList.remove('is-open');
      g.querySelector('.nav-trigger')?.setAttribute('aria-expanded', 'false');
    });
  }

  groups.forEach((group) => {
    const trigger = group.querySelector<HTMLButtonElement>('.nav-trigger');
    trigger?.addEventListener('click', () => {
      const open = !group.classList.contains('is-open');
      closeGroups(group);
      group.classList.toggle('is-open', open);
      trigger.setAttribute('aria-expanded', String(open));
    });
    group.addEventListener('focusout', (e) => {
      if (!group.contains(e.relatedTarget as Node)) {
        group.classList.remove('is-open');
        trigger?.setAttribute('aria-expanded', 'false');
      }
    });
  });

  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.nav-group')) closeGroups();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const openGroup = document.querySelector<HTMLElement>('.nav-group.is-open');
    if (openGroup) {
      closeGroups();
      openGroup.querySelector<HTMLButtonElement>('.nav-trigger')?.focus();
    }
    if (menu && !menu.classList.contains('hidden')) {
      setMobileMenu(false);
      btn?.focus();
    }
  });
</script>
