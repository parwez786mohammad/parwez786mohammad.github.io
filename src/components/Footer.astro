---
const links = [
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/journey', label: 'Journey' },
  { href: '/toastmasters', label: 'Toastmasters' },
  { href: '/blog', label: 'Blog' },
  { href: '/videos', label: 'Videos' },
  { href: '/testimonials', label: 'Testimonials' },
  { href: '/resources', label: 'Resources' },
  { href: '/now', label: 'Now' },
  { href: '/contact', label: 'Contact' },
];
const year = new Date().getFullYear();
---
<footer class="border-t border-ink-950/8 bg-ink-950 text-ink-100">
  <div class="container-page py-14">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <a href="/" class="flex items-center gap-2.5 font-serif text-lg font-semibold text-white">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white font-mono text-xs font-bold text-ink-950">MP</span>
          Mohammad Parwez
        </a>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-ink-100/70">
          PMP® Certified Project Manager and Warehouse &amp; Logistics Automation expert helping organizations
          across the UAE and Middle East modernize supply chains through digital transformation and AI.
        </p>
        <div class="mt-5 flex gap-3">
          <a href="https://www.linkedin.com/in/mohammad-parwez-18bb01a7/" target="_blank" rel="noopener" class="grid h-9 w-9 place-items-center rounded-full border border-white/15 hover:border-white/40" aria-label="LinkedIn">in</a>
          <a href="https://www.youtube.com/@TheMohammadParwez" target="_blank" rel="noopener" class="grid h-9 w-9 place-items-center rounded-full border border-white/15 hover:border-white/40" aria-label="YouTube">yt</a>
          <a href="https://www.instagram.com/themohammadparwez.1611/" target="_blank" rel="noopener" class="grid h-9 w-9 place-items-center rounded-full border border-white/15 hover:border-white/40" aria-label="Instagram">ig</a>
          <a href="mailto:mohammad.parwez@span-group.com" class="grid h-9 w-9 place-items-center rounded-full border border-white/15 hover:border-white/40" aria-label="Email">@</a>
        </div>
      </div>

      <div>
        <h4 class="eyebrow text-ink-100/50">Explore</h4>
        <ul class="mt-4 space-y-2 text-sm">
          {links.slice(0, 5).map((l) => <li><a href={l.href} class="text-ink-100/75 hover:text-white">{l.label}</a></li>)}
        </ul>
      </div>

      <div>
        <h4 class="eyebrow text-ink-100/50">More</h4>
        <ul class="mt-4 space-y-2 text-sm">
          {links.slice(5).map((l) => <li><a href={l.href} class="text-ink-100/75 hover:text-white">{l.label}</a></li>)}
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-start justify-between gap-4 border-t border-white/10 pt-6 text-xs text-ink-100/50 sm:flex-row sm:items-center">
      <p>© {year} Mohammad Parwez. All rights reserved.</p>
      <p>Built with Astro · Hosted on GitHub Pages</p>
    </div>
  </div>
</footer>
