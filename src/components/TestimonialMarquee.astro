---
import { getCollection } from 'astro:content';
import TestimonialCard from './TestimonialCard.astro';

const testimonials = await getCollection('testimonials');
// Duplicate the list so the CSS animation can loop seamlessly.
const track = [...testimonials, ...testimonials];
---
{testimonials.length > 0 && (
  <>
    <div class="marquee-mask">
      <div class="marquee-track" id="testimonial-track">
        {track.map((t) => (
          <div class="marquee-item">
            <TestimonialCard testimonial={t} class="h-full" />
          </div>
        ))}
      </div>
    </div>

    <div id="testimonial-modal" class="testimonial-modal" hidden>
      <div class="testimonial-modal-backdrop" data-close></div>
      <div class="testimonial-modal-panel" role="dialog" aria-modal="true" aria-labelledby="testimonial-modal-name">
        <button type="button" class="testimonial-modal-close" data-close aria-label="Close">&times;</button>
        <span id="testimonial-modal-category" class="inline-block rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-semibold text-brand-700"></span>
        <div class="mt-4 flex items-center gap-4">
          <img id="testimonial-modal-avatar" src="" alt="" class="h-14 w-14 rounded-full object-cover ring-4 ring-brand-50" style="display:none" />
          <div id="testimonial-modal-avatar-fallback" class="grid h-14 w-14 place-items-center rounded-full bg-brand-50 font-serif text-lg font-semibold text-brand-700 ring-4 ring-brand-50" style="display:none"></div>
          <div>
            <p id="testimonial-modal-name" class="text-sm font-semibold text-ink-950"></p>
            <p id="testimonial-modal-role" class="text-xs text-ink-500"></p>
          </div>
        </div>
        <p id="testimonial-modal-quote" class="mt-5 text-sm leading-relaxed text-ink-700"></p>
      </div>
    </div>
  </>
)}

<style>
  .marquee-mask {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
    mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
  }
  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 36s linear infinite;
  }
  .marquee-track:hover,
  .marquee-track.is-paused {
    animation-play-state: paused;
  }
  .marquee-item {
    width: 20rem;
    height: 19.5rem;
    flex-shrink: 0;
    margin: 0 0.75rem;
  }
  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      overflow-x: auto;
    }
  }

  .testimonial-modal {
    position: fixed;
    inset: 0;
    z-index: 50;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }
  .testimonial-modal[hidden] {
    display: none;
  }
  .testimonial-modal:not([hidden]) {
    display: flex;
  }
  .testimonial-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 15, 20, 0.55);
  }
  .testimonial-modal-panel {
    position: relative;
    max-width: 32rem;
    width: 100%;
    max-height: min(32rem, 85vh);
    overflow-y: auto;
    background: white;
    border-radius: 1.25rem;
    padding: 2rem;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35);
  }
  .testimonial-modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    display: grid;
    place-items: center;
    font-size: 1.25rem;
    line-height: 1;
    color: #6b7280;
    background: transparent;
  }
  .testimonial-modal-close:hover {
    background: rgba(0, 0, 0, 0.05);
  }
</style>

<script>
  const track = document.getElementById('testimonial-track');
  const modal = document.getElementById('testimonial-modal');

  if (modal && track) {
    const nameEl = document.getElementById('testimonial-modal-name');
    const roleEl = document.getElementById('testimonial-modal-role');
    const quoteEl = document.getElementById('testimonial-modal-quote');
    const categoryEl = document.getElementById('testimonial-modal-category');
    const avatarEl = document.getElementById('testimonial-modal-avatar') as HTMLImageElement;
    const avatarFallbackEl = document.getElementById('testimonial-modal-avatar-fallback');
    let lastTrigger: HTMLElement | null = null;

    function openModal(card: HTMLElement, trigger: HTMLElement) {
      const { quote, name, role, org, avatar, category } = card.dataset;
      if (nameEl) nameEl.textContent = name ?? '';
      if (roleEl) roleEl.textContent = org ? `${role} · ${org}` : (role ?? '');
      if (quoteEl) quoteEl.textContent = `“${quote ?? ''}”`;
      if (categoryEl) categoryEl.textContent = category ?? '';

      if (avatar && avatarEl && avatarFallbackEl) {
        avatarEl.src = avatar;
        avatarEl.alt = name ?? '';
        avatarEl.style.display = '';
        avatarFallbackEl.style.display = 'none';
      } else if (avatarEl && avatarFallbackEl) {
        avatarEl.style.display = 'none';
        avatarFallbackEl.style.display = 'grid';
        avatarFallbackEl.textContent = name ? name.charAt(0) : '';
      }

      lastTrigger = trigger;
      modal.hidden = false;
      track?.classList.add('is-paused');
      document.body.style.overflow = 'hidden';
      const closeBtn = modal.querySelector<HTMLButtonElement>('.testimonial-modal-close');
      closeBtn?.focus();
    }

    function closeModal() {
      modal.hidden = true;
      track?.classList.remove('is-paused');
      document.body.style.overflow = '';
      lastTrigger?.focus();
    }

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const btn = target.closest<HTMLElement>('.read-more-btn');
      if (btn) {
        const card = btn.closest<HTMLElement>('.testimonial-card');
        if (card) openModal(card, btn);
        return;
      }
      if (target.closest('[data-close]')) {
        closeModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.hidden) closeModal();
    });
  }
</script>
